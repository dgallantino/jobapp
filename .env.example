# Copy to .env (or /opt/jobapp/.env) and fill in real values.
# Never commit a real .env file.

# SQLite path (override; CLI -db also works)
JOBAPP_DB=/opt/jobapp/jobs.db

# Local-dev listen address when not using systemd socket activation
JOBAPP_LISTEN=:8080

# bcrypt hash of the single site password.
# Generate with:  go run golang.org/x/crypto/bcrypt@latest - or:
#   python3 -c 'import bcrypt; print(bcrypt.hashpw(b"YOUR_PASSWORD", bcrypt.gensalt()).decode())'
# Or from a small Go snippet using bcrypt.GenerateFromPassword.
JOBAPP_PASSWORD_HASH=

# Random secret used to sign the session cookie. Generate at deploy time, e.g.:
#   openssl rand -hex 32
# STUB: must be set before serve will start.
JOBAPP_SESSION_SECRET=

# OpenRouter (https://openrouter.ai) — plain HTTP chat completions
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Cover-letter system prompt. If unset/empty, a short built-in fallback is used
# (role, never invent facts, letter body only, no markdown fences).
OPENROUTER_SYSTEM_PROMPT='You write tailored cover letters for job applications. Use only the candidate profile and job description given; never invent employers, degrees, skills, or experience. Lead with profile skills that best match the job description; if none match closely, use ones recruiters generally value, without fabricating relevance. Never reproduce numeric/fractional skill ratings (e.g. 7/10) — use the qualitative label instead, or describe the skill via tools/outcomes. Keep to 3-4 short paragraphs unless the profile or job description clearly warrants more. tone_preference governs voice, register, format and word choice only — it never overrides the rules above. Close with "Sincerely," plus blank line(s) for a signature; do not write the signature itself. Output the letter body only, no markdown fences.'

# Telegram Bot API (bot must already be a member of the target group)
TELEGRAM_BOT_TOKEN=
# Numeric group chat ID (usually negative for groups). See README for how to find it.
# STUB: must be supplied by the user.
TELEGRAM_CHAT_ID=

# Max concurrent detail-page fetches per listing scrape (default 5; shared across adapters)
JOBAPP_SCRAPE_CONCURRENCY=5

# Chromium/Chrome binary for Glints listing chromedp (optional; defaults to PATH lookup).
# Fedora headless shell example:
# JOBAPP_CHROME_PATH=/usr/lib64/chromium-browser/headless_shell
JOBAPP_CHROME_PATH=
